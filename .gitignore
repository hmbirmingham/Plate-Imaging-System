# Python
__pycache__/
*.py[cod]
*.pyo
venv/
.venv/
*.egg-info/
.pytest_cache/

# Compiled C extension — rebuilt per-platform by led_pwm.py, never commit
*.so

# Captured images — too large for git
captures/
results/

# ML model — regenerated from training data
models/

# Data — tracked separately via cloud sync
data/

# Other projects accidentally in this folder
focus-guard/

# Claude settings
.claude/

# OS
.DS_Store
Thumbs.db

# Logs
*.log

# Continuous testing harness — generated test artifacts, never commit raw
# outputs. Regenerable from testing/continuous/*.py + the seed logged in
# each cycle's Phase A record — commit the generator, not the output.
testing/logs/
testing/artifacts/
testing/reports/cycle_*
testing/reports/aggregate_state.json
testing/thesis_export/generated/

# aggregate_report.md itself IS committed periodically (once per branch
# merge) as the thesis-relevant snapshot — only the raw per-cycle data
# behind it (above) is excluded.
!testing/reports/aggregate_report.md
